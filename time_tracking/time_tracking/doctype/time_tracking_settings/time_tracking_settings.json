   "options": "Time Tracking Project"
  },
  {
   "fieldname": "notifications_tab",
   "fieldtype": "Tab Break",
   "label": "Notifications"
  },
  {
   "fieldname": "notifications_section",
   "fieldtype": "Section Break",
   "label": "Booking Reminders"
  },
  {
   "default": "0",
   "description": "Send reminders when time bookings are missing.",
   "fieldname": "enable_monthly_booking_reminder",
   "fieldtype": "Check",
   "label": "Enable Booking Reminders"
  },
  {
   "default": "25",
   "description": "Day of month to send the reminder (uses the last day if the month is shorter).",
   "fieldname": "monthly_booking_reminder_day",
   "fieldtype": "Int",
   "label": "Monthly Reminder Day",
   "min_value": "1",
   "max_value": "31",
   "depends_on": "eval:doc.enable_monthly_booking_reminder && doc.booking_reminder_trigger === 'Monthly'"
  },
  {
   "fieldname": "booking_reminder_trigger",
   "fieldtype": "Select",
   "label": "Reminder Trigger",
   "options": "Month End\nMonthly\nWeekly\nInactivity\nMissing Days Threshold",
   "default": "Month End",
   "depends_on": "eval:doc.enable_monthly_booking_reminder",
   "description": "Choose when reminder emails should be sent."
  },
  {
   "fieldname": "booking_reminder_weekday",
   "fieldtype": "Select",
   "label": "Weekly Reminder Day",
   "options": "Monday\nTuesday\nWednesday\nThursday\nFriday\nSaturday\nSunday",
   "default": "Friday",
   "depends_on": "eval:doc.enable_monthly_booking_reminder && doc.booking_reminder_trigger === 'Weekly'"
  },
  {
   "fieldname": "booking_reminder_inactivity_days",
   "fieldtype": "Int",
   "label": "Inactivity Days Threshold",
   "default": "5",
   "min_value": "1",
   "depends_on": "eval:doc.enable_monthly_booking_reminder && doc.booking_reminder_trigger === 'Inactivity'",
   "description": "Send a reminder when no bookings have been made for this many days."
  },
  {
   "fieldname": "booking_reminder_missing_days_threshold",
   "fieldtype": "Int",
   "label": "Missing Days Threshold",
   "default": "3",
   "min_value": "1",
   "depends_on": "eval:doc.enable_monthly_booking_reminder && doc.booking_reminder_trigger === 'Missing Days Threshold'",
   "description": "Send a reminder when the number of missing booking days reaches this value."
  },
