  },
  {
   "fieldname": "overtime_tab",
   "fieldtype": "Tab Break",
   "label": "Overtime"
  },
  {
   "fieldname": "overtime_section",
   "fieldtype": "Section Break",
   "label": "Overtime"
  },
  {
   "default": "Weekly",
   "description": "Default period used to calculate overtime balances.",
   "fieldname": "overtime_calculation_period",
   "fieldtype": "Select",
   "label": "Overtime Calculation Period",
   "options": "Weekly\nMonthly",
   "reqd": 1
  },
  {
   "default": "1",
   "description": "When enabled, the profile target period can override the default overtime period.",
   "fieldname": "allow_target_period_override",
   "fieldtype": "Check",
   "label": "Allow Target Period Override"
  },
  {
   "default": "1",
   "description": "Count vacation bookings towards overtime actuals.",
   "fieldname": "include_vacation_in_overtime",
   "fieldtype": "Check",
   "label": "Include Vacation in Overtime"
  },
  {
   "default": "1",
   "description": "Count sickness bookings towards overtime actuals.",
   "fieldname": "include_sickness_in_overtime",
   "fieldtype": "Check",
   "label": "Include Sickness in Overtime"
  },
  {
   "default": "0",
   "description": "Allow overtime balances to go negative.",
   "fieldname": "allow_negative_overtime_balance",
   "fieldtype": "Check",
   "label": "Allow Negative Overtime Balance"
  },
  {
   "default": "Cap",
   "description": "How to handle overtime balances at year end.",
   "fieldname": "overtime_year_end_policy",
   "fieldtype": "Select",
   "label": "Overtime Year End Policy",
   "options": "Carryover\nCap\nReset",
   "reqd": 1
  },
  {
   "description": "Maximum hours to carry into the next year when policy is set to Cap.",
   "fieldname": "carryover_limit_hours",
   "fieldtype": "Float",
   "label": "Carryover Limit (Hours)",
   "depends_on": "eval:doc.overtime_year_end_policy === 'Cap'"
  },
  {
   "fieldname": "vacation_tab",
   "fieldtype": "Tab Break",
   "label": "Vacation"
  },
  {
   "fieldname": "vacation_section",
   "fieldtype": "Section Break",
   "label": "Vacation"
  },
  {
   "description": "Project used for vacation bookings.",
   "fieldname": "vacation_booking_project",
   "fieldtype": "Link",
   "label": "Vacation Booking Project",
   "options": "Time Tracking Project"
  },
  {
   "default": "5",
   "description": "Default workdays per week for vacation calculations.",
   "fieldname": "default_workdays_per_week",
   "fieldtype": "Float",
   "label": "Default Workdays per Week",
   "min_value": "0.1"
  },
  {
   "default": "0",
   "description": "Allow vacation bookings to exceed available days.",
   "fieldname": "allow_negative_vacation_balance",
   "fieldtype": "Check",
   "label": "Allow Negative Vacation Balance"
  },
  {
   "default": "Cap",
   "description": "How to handle unused vacation days at year end.",
   "fieldname": "vacation_year_end_policy",
   "fieldtype": "Select",
   "label": "Vacation Year End Policy",
   "options": "Carryover\nCap\nReset",
   "reqd": 1
  },
  {
   "description": "Maximum vacation days to carry into the next year when policy is set to Cap.",
   "fieldname": "vacation_carryover_limit_days",
   "fieldtype": "Float",
   "label": "Vacation Carryover Limit (Days)",
   "depends_on": "eval:doc.vacation_year_end_policy === 'Cap'"
  },
